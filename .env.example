# =====================================================================
# Identimarketing - Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to source control.
# =====================================================================

# --- Supabase ---------------------------------------------------------
# Get these from your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- App --------------------------------------------------------------
# Base URL of the deployed app (used in email links, callbacks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used for internal service-to-service JWTs (e.g. GHL webhook signing).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-32-byte-hex-string

# --- Transactional email (nodemailer / Gmail) -------------------------
# Used only for app notifications (contact form, onboarding leads, welcome).
# Supabase Auth handles verification + password reset emails directly.
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your-gmail-app-password
NOTIFY_EMAIL=ops@identimarketing.com

# --- Monitoring (optional, leave blank to disable) --------------------
SENTRY_DSN=

# --- OpenAI (used by AI chat / Empire OS skills) ----------------------
OPENAI_API_KEY=

# --- Go High Level (Phase 2 - SMS, email sync, contact sync) ----------
# Used as defaults when a tenant has not configured its own GHL credentials
# (tenants.ghl_location_id / tenants.ghl_api_key columns).
# Generate a Private Integration Token at: https://marketplace.gohighlevel.com/
# NEVER commit real values to this file - put them in .env.local only.
# Go High Level SMS (used when tenants.ghl_location_id / ghl_api_key are empty, or as defaults for dev)
GHL_LOCATION_ID=DjRJFFDoB7f6WUJjZvfh
GHL_API_KEY=pit-d1311006-79be-4f3e-866d-feb04c13fc68

# --- Empire OS (Phase 3 - skill execution, recommendations) -----------
# Anthropic Claude is used to execute marketing skills against project data.
# Generate a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ANALYSIS=claude-sonnet-4-20250514
ANTHROPIC_MODEL_BULK=claude-haiku-4-20250514

# Bearer token required by /api/cron/* routes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vercel Cron: add the same value as a Bearer in your cron config.
CRON_SECRET=

# Hourly USD budget for Empire OS LLM spend. The executor short-circuits
# additional skill runs once this is exceeded and resumes at the next hour.
EMPIRE_OS_BUDGET_PER_HOUR_USD=5

# --- Stripe (Phase 5 - billing & subscriptions) -----------------------
# Get keys at https://dashboard.stripe.com/apikeys. Use test keys in
# development (sk_test_..., pk_test_...).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Set after running `stripe listen --forward-to localhost:3000/api/billing/webhook`
# OR from the dashboard Webhooks page after creating the endpoint.
STRIPE_WEBHOOK_SECRET=

# Price IDs (Stripe dashboard -> Products). Each plan has a monthly price.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# Where Stripe Checkout / Portal redirects after success/cancel. Defaults
# to NEXT_PUBLIC_APP_URL when not set.
STRIPE_BILLING_RETURN_URL=